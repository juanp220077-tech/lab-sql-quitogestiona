{
  "name": "Laboratorio SQL Server - QuitoGestiona",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/powershell:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-mssql.mssql",
        "ms-vscode.powershell"
      ]
    }
  },
  "postCreateCommand": "pwsh -Command 'Install-Module -Name dbatools -Scope CurrentUser -Force'"
}
